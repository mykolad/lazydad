{
  "JokeGeneration": {
    "UniquenessSampleSize": 20,
    "Languages": [
      {
        "Language": "Ukrainian",
        "LanguageCode": "uk",
        "Enabled": true,
        "IntervalHours": 4,
        "PromptHint": "Write the dad joke in Ukrainian. Use Ukrainian cultural humor style.",
        "LlmModels": [
          { "Provider": "AzureOpenAI", "Model": "gpt-5.3-chat" },
          { "Provider": "AzureOpenAI", "Model": "gpt-6-luna" }
        ]
      }
    ]
  },
  "TopJokes": {
    "Enabled": true,
    "Size": 3,
    "SeedSampleSize": 100,
    "Judge": { "Provider": "AzureOpenAI", "Model": "gpt-6-sol" },
    "JudgeReasoningEffort": "High"
  },
  "LlmProviders": {
    "AzureOpenAI": {
      "Endpoint": "",
      "ApiKey": ""
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
