# The repository's C# style. The build enforces the rules marked warning (EnforceCodeStyleInBuild, warnings as errors).
root = true

[*.cs]
indent_style = space
indent_size = 4

# File-scoped namespaces and usings outside them, as the code is written.
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

# `this.` only when a parameter has the same name (CLAUDE.md).
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_diagnostic.IDE0003.severity = warning
dotnet_diagnostic.IDE0009.severity = warning

# Private fields: camelCase, no underscore (CLAUDE.md). Constants and static readonly fields: PascalCase.
dotnet_naming_rule.constants_are_pascal_case.symbols = constants
dotnet_naming_rule.constants_are_pascal_case.style = pascal_case
dotnet_naming_rule.constants_are_pascal_case.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_rule.static_readonly_fields_are_pascal_case.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields_are_pascal_case.style = pascal_case
dotnet_naming_rule.static_readonly_fields_are_pascal_case.severity = warning
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly

dotnet_naming_rule.private_fields_are_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_are_camel_case.style = camel_case
dotnet_naming_rule.private_fields_are_camel_case.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_diagnostic.IDE1006.severity = warning

# Logging: CA1848 (LoggerMessage delegates) and CA1873 (arguments computed for a disabled level) both point at
# source-generated logging, which #104 decides on. Until then, ILogger extension methods are the house style.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none

# EF Core writes the migrations; their style is the tool's.
[src/LazyDad.Data/Migrations/**.cs]
generated_code = true

[tests/**.cs]
# Test names read as sentences: Method_Scenario_Outcome.
dotnet_diagnostic.CA1707.severity = none
# Performance rules that don't matter in tests: constant arrays as arguments, concrete types instead of interfaces, and
# static helpers (fixtures expose theirs as instance members).
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA1822.severity = none
